---
import { Home, Bell, Upload } from "lucide-react";
import { buttonVariants } from "./ui/button";

export interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "Aranda", subtitle = "" } = Astro.props;
---

<header class="bg-stone-950 border-b-4 border-amber-500/30 shadow-md">
  <div class="max-w-5xl mx-auto px-6 py-5 flex items-center justify-between">
    <!-- Logo + Título -->
    <div class="flex items-center gap-3">
      <div class="bg-amber-400 rounded-2xl w-12 h-12 flex items-center justify-center shadow-sm">
        <Home className="w-6 h-6 text-stone-900" strokeWidth={2.5} />
      </div>
      <div>
        <h1 class="text-2xl font-extrabold text-amber-400 leading-none tracking-tight">
          {title}
        </h1>
        <p class="text-xs text-stone-400 font-medium mt-0.5">{subtitle}</p>
      </div>
    </div>

    <!-- Acciones rápidas -->
    <div class="flex items-center gap-3">
      <button
        class="relative bg-stone-900 border-2 border-stone-800 rounded-xl px-3 py-2 text-amber-400 hover:bg-stone-800 hover:border-amber-500/50 transition-all duration-200 flex items-center gap-1.5 text-sm font-semibold shadow-sm"
        aria-label="Notificaciones"
      >
        <Bell className="w-4 h-4" />
        <span class="absolute -top-1.5 -right-1.5 bg-rose-500 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center font-bold">3</span>
      </button>

      <a
        href="/subir_imagen"
        class:list={[buttonVariants({ variant: "default", size: "lg" }), "h-auto py-2"]}
      >
        <Upload className="w-4 h-4" />
        <span class="hidden sm:inline">Subir</span>
      </a>

      <!-- Avatar familiar -->
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-rose-600 flex items-center justify-center text-white font-extrabold text-sm shadow-sm cursor-pointer hover:scale-105 transition-transform duration-200">
        FH
      </div>
    </div>
  </div>
</header>
