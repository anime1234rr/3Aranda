---
export interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "Aranda", subtitle = "" } = Astro.props;
---

<header class="bg-amber-50 border-b-4 border-amber-300 shadow-md">
  <div class="max-w-5xl mx-auto px-6 py-5 flex items-center justify-between">
    <!-- Logo + Título -->
    <div class="flex items-center gap-3">
      <div class="bg-amber-400 rounded-2xl w-12 h-12 flex items-center justify-center shadow-sm">
        <span class="text-2xl">🏡</span>
      </div>
      <div>
        <h1 class="text-2xl font-extrabold text-amber-900 leading-none tracking-tight">
          {title}
        </h1>
        <p class="text-xs text-amber-600 font-medium mt-0.5">{subtitle}</p>
      </div>
    </div>

    <!-- Acciones rápidas -->
    <div class="flex items-center gap-3">
      <button
        class="relative bg-white border-2 border-amber-200 rounded-xl px-3 py-2 text-amber-700 hover:bg-amber-100 hover:border-amber-400 transition-all duration-200 flex items-center gap-1.5 text-sm font-semibold shadow-sm"
        aria-label="Notificaciones"
      >
        🔔
        <span class="absolute -top-1.5 -right-1.5 bg-red-400 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center font-bold">3</span>
      </button>

      <a
        href="/upload"
        class="bg-amber-400 hover:bg-amber-500 text-amber-900 font-bold text-sm px-4 py-2 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex items-center gap-1.5"
      >
        <span>📤</span>
        <span class="hidden sm:inline">Subir</span>
      </a>

      <!-- Avatar familiar -->
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-300 to-rose-400 flex items-center justify-center text-white font-extrabold text-sm shadow-sm cursor-pointer hover:scale-105 transition-transform duration-200">
        FH
      </div>
    </div>
  </div>
</header>