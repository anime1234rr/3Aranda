---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  date?: string;
  tag?: string;
  tagColor?: "amber" | "rose" | "green" | "blue";
  href?: string;
}

const {
  title,
  description,
  image,
  date,
  tag,
  tagColor = "amber",
  href = "#",
} = Astro.props;

const tagStyles: Record<string, string> = {
  amber: "bg-amber-100 text-amber-700 border-amber-200",
  rose:  "bg-rose-100 text-rose-700 border-rose-200",
  green: "bg-green-100 text-green-700 border-green-200",
  blue:  "bg-blue-100 text-blue-700 border-blue-200",
};
---

<a
  href={href}
  class="group block bg-white rounded-2xl border-2 border-amber-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-amber-300 transition-all duration-300 overflow-hidden"
>
  <!-- Imagen / placeholder -->
  {image ? (
    <div class="h-44 overflow-hidden bg-amber-50">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    </div>
  ) : (
    <div class="h-44 bg-gradient-to-br from-amber-50 to-rose-50 flex items-center justify-center">
      <span class="text-5xl opacity-40">📷</span>
    </div>
  )}

  <!-- Contenido -->
  <div class="p-5">
    {tag && (
      <span class:list={["inline-block text-xs font-bold px-2.5 py-0.5 rounded-full border mb-3", tagStyles[tagColor]]}>
        {tag}
      </span>
    )}

    <h3 class="font-extrabold text-stone-800 text-lg leading-tight mb-1 group-hover:text-amber-700 transition-colors duration-200">
      {title}
    </h3>

    {description && (
      <p class="text-stone-500 text-sm leading-relaxed line-clamp-2">
        {description}
      </p>
    )}

    {date && (
      <div class="mt-4 flex items-center gap-1.5 text-xs text-stone-400 font-medium">
        <span>📅</span>
        <span>{date}</span>
      </div>
    )}
  </div>
</a>