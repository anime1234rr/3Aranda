---
import { ImageOff, Calendar } from "lucide-react";
import { Badge } from "./ui/badge";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  date?: string;
  tag?: string;
  tagColor?: "amber" | "rose" | "green" | "blue";
  href?: string;
}

const {
  title,
  description,
  image,
  date,
  tag,
  tagColor = "amber",
  href = "#",
} = Astro.props;
---

<a
  href={href}
  class="group block bg-stone-900 rounded-2xl border border-stone-800 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-amber-500/40 transition-all duration-300 overflow-hidden"
>
  <!-- Imagen / placeholder -->
  {image ? (
    <div class="h-44 overflow-hidden bg-stone-800">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    </div>
  ) : (
    <div class="h-44 bg-gradient-to-br from-stone-800 to-stone-900 flex items-center justify-center">
      <ImageOff className="w-10 h-10 text-stone-600" strokeWidth={1.5} />
    </div>
  )}

  <!-- Contenido -->
  <div class="p-5">
    {tag && (
      <Badge variant={tagColor} className="mb-3">{tag}</Badge>
    )}

    <h3 class="font-extrabold text-stone-100 text-lg leading-tight mb-1 group-hover:text-amber-400 transition-colors duration-200">
      {title}
    </h3>

    {description && (
      <p class="text-stone-400 text-sm leading-relaxed line-clamp-2">
        {description}
      </p>
    )}

    {date && (
      <div class="mt-4 flex items-center gap-1.5 text-xs text-stone-500 font-medium">
        <Calendar className="w-3.5 h-3.5" />
        <span>{date}</span>
      </div>
    )}
  </div>
</a>