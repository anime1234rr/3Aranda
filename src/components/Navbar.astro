---
export interface NavItem {
  label: string;
  href: string;
  icon: string;
}

export interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navItems: NavItem[] = [
  { label: "Inicio",    href: "/",        icon: "🏠" },
  { label: "Álbum",     href: "/album",   icon: "📸" },
  { label: "Recuerdos", href: "/memories",icon: "💛" },
  { label: "Subir",     href: "/upload",  icon: "📤" },
  { label: "Entrar",    href: "/login",   icon: "🔑" },
];
---

<nav class="bg-white border-b-2 border-amber-100 sticky top-0 z-40 shadow-sm">
  <div class="max-w-5xl mx-auto px-4">
    <ul class="flex items-center gap-1 overflow-x-auto scrollbar-hide py-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-sm whitespace-nowrap transition-all duration-200",
                isActive
                  ? "bg-amber-100 text-amber-800 shadow-inner border border-amber-200"
                  : "text-stone-500 hover:bg-amber-50 hover:text-amber-700"
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              <span class="text-base">{item.icon}</span>
              <span>{item.label}</span>
              {isActive && (
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 ml-0.5"></span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</nav>