---
import { Home, Image, Heart, Upload, LogIn, type LucideIcon } from "lucide-react";

export interface NavItem {
  label: string;
  href: string;
  icon: LucideIcon;
}

export interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navItems: NavItem[] = [
  { label: "Inicio",    href: "/",        icon: Home },
  { label: "Álbum",     href: "/album",   icon: Image },
  { label: "Recuerdos", href: "/recuerdos",icon: Heart },
  { label: "Subir",     href: "/subir_imagen",  icon: Upload },
  { label: "Entrar",    href: "/iniciar_sesion",   icon: LogIn },
];
---

<nav class="bg-stone-950 border-b-2 border-stone-800 sticky top-0 z-40 shadow-sm">
  <div class="max-w-5xl mx-auto px-4">
    <ul class="flex items-center gap-1 overflow-x-auto scrollbar-hide py-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href;
        const Icon = item.icon;
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-sm whitespace-nowrap transition-all duration-200",
                isActive
                  ? "bg-amber-500/10 text-amber-400 shadow-inner border border-amber-500/30"
                  : "text-stone-400 hover:bg-stone-900 hover:text-amber-300"
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              <Icon className="w-4 h-4" />
              <span>{item.label}</span>
              {isActive && (
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 ml-0.5"></span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</nav>