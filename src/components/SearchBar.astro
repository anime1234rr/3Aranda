---
import { Search } from "lucide-react";
import { buttonVariants } from "./ui/button";

export interface Props {
  placeholder?: string;
  value?: string;
}

const {
  placeholder = "Buscar recuerdos, fechas, personas…",
  value = "",
} = Astro.props;
---

<div class="w-full">
  <div class="relative group">
    <!-- Icono lupa -->
    <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
      <Search className="w-5 h-5 text-amber-400 group-focus-within:text-amber-300 transition-colors duration-200" strokeWidth={2.5} />
    </div>

    <!-- Input -->
    <input
      type="search"
      id="family-search"
      name="q"
      value={value}
      placeholder={placeholder}
      class="w-full pl-12 pr-24 py-3.5 bg-stone-900 border-2 border-stone-800 rounded-2xl text-stone-100 placeholder-stone-500 text-sm font-medium
             focus:outline-none focus:border-amber-500/60 focus:shadow-md
             hover:border-stone-700 transition-all duration-200"
      autocomplete="off"
    />

    <!-- Botón buscar -->
    <button
      type="submit"
      class:list={[buttonVariants({ variant: "default" }), "absolute inset-y-0 right-2 my-2 h-auto px-4"]}
      aria-label="Buscar"
    >
      Buscar
    </button>
  </div>

  <!-- Sugerencias rápidas -->
  <div class="flex flex-wrap gap-2 mt-3">
    {["Navidad", "Cumpleaños", "Verano 2024", "Abuelos"].map((tag) => (
      <button
        type="button"
        class="text-xs px-3 py-1 bg-stone-900 border border-stone-800 text-amber-400 rounded-full hover:bg-stone-800 hover:border-amber-500/40 transition-all duration-150 font-medium"
        onclick={`document.getElementById('family-search').value='${tag}'`}
      >
        {tag}
      </button>
    ))}
  </div>
</div>