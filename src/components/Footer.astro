---
import { getRelativeLocaleUrl } from "astro:i18n";
import { obtenerIdioma, textos } from "../lib/i18n";

const locale = obtenerIdioma(Astro.currentLocale);
const t = textos[locale];
const url = (ruta: string) => getRelativeLocaleUrl(locale, ruta);
---

<footer class="border-t border-stone-800 bg-stone-950 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-10">
    <div class="grid grid-cols-1 items-start gap-6 sm:grid-cols-2 sm:gap-8 md:grid-cols-4">
      <div class="rounded-2xl border border-stone-800/60 bg-stone-900/30 p-8 sm:col-span-2">
        <span class="block font-serif text-2xl leading-none font-bold text-stone-100">3Aranda</span>
        <p class="mt-5 max-w-sm leading-relaxed text-stone-500">
          {t.footerDescripcion}
        </p>
      </div>

      <div class="rounded-2xl border border-stone-800/60 bg-stone-900/30 p-8">
        <h4 class="mb-6 text-xs leading-none font-bold tracking-widest text-stone-200 uppercase">
          {t.footerRecursos}
        </h4>
        <ul class="list-none space-y-4 text-sm text-stone-500">
          <li>
            <a href={url("/recuerdos")} class="block transition-colors hover:text-amber-500">{t.footerGaleria}</a>
          </li>
          <li>
            <a href={url("/soporte")} class="block transition-colors hover:text-amber-500">{t.footerSoporte}</a>
          </li>
          <li>
            <a href={url("/api")} class="block transition-colors hover:text-amber-500">{t.footerApi}</a>
          </li>
        </ul>
      </div>

      <div class="rounded-2xl border border-stone-800/60 bg-stone-900/30 p-8">
        <h4 class="mb-6 text-xs leading-none font-bold tracking-widest text-stone-200 uppercase">
          {t.footerLegal}
        </h4>
        <ul class="list-none space-y-4 text-sm text-stone-500">
          <li>
            <a href={url("/legal/privacidad")} class="block transition-colors hover:text-amber-500">{t.footerPrivacidad}</a>
          </li>
          <li>
            <a href={url("/legal/terminos")} class="block transition-colors hover:text-amber-500">{t.footerTerminos}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 border-t border-stone-900 pt-10 text-center text-xs text-stone-600">
      &copy; {new Date().getFullYear()} AngelDavid. {t.footerDerechos}
    </div>
  </div>
</footer>
