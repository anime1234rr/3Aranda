---
import Layout from "../layouts/Layout.astro";
import { Upload, FolderOpen, Calendar, Tag, Users, Save, X } from "lucide-react";
import { Label } from "../components/ui/label";
import { Input } from "../components/ui/input";
import { Textarea } from "../components/ui/textarea";
import { buttonVariants } from "../components/ui/button";
---

<Layout title="Subir Recuerdo" currentPath="/subir_imagen">
  <div class="max-w-2xl mx-auto">

    <!-- Título -->
    <div class="mb-8">
      <h1 class="text-2xl font-extrabold text-stone-100 flex items-center gap-2">
        <Upload className="w-6 h-6 text-amber-400" /> Subir un recuerdo
      </h1>
      <p class="text-stone-400 text-sm mt-1 font-medium">
        Comparte un momento especial con toda la familia
      </p>
    </div>

    <form
      id="upload-form"
      enctype="multipart/form-data"
      class="bg-stone-900 rounded-3xl border border-stone-800 shadow-md p-8 space-y-7"
    >

      <!-- Zona de drop -->
      <div>
        <Label className="mb-2">Archivos</Label>
        <div
          id="dropzone"
          class="relative border-2 border-dashed border-stone-700 rounded-2xl p-10 text-center
                 bg-stone-950/40 hover:bg-stone-800/60 hover:border-amber-500/50 transition-all duration-200 cursor-pointer group"
        >
          <input
            type="file"
            id="file-input"
            name="files"
            multiple
            accept="image/*,video/*"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
          />
          <div class="pointer-events-none flex flex-col items-center">
            <FolderOpen className="w-12 h-12 text-amber-400 mb-3" strokeWidth={1.5} />
            <p class="font-extrabold text-amber-400 text-base">
              Arrastra tus fotos o vídeos aquí
            </p>
            <p class="text-stone-400 text-sm mt-1 font-medium">
              o haz clic para seleccionar archivos
            </p>
            <p class="text-xs text-stone-500 mt-3 font-medium">
              JPG, PNG, GIF, MP4 · Máx. 50 MB por archivo
            </p>
          </div>
        </div>

        <!-- Preview área -->
        <div id="preview" class="hidden mt-4 grid grid-cols-3 gap-3"></div>
      </div>

      <!-- Título del recuerdo -->
      <div>
        <Label htmlFor="title" className="mb-1.5">
          Título del recuerdo <span class="text-rose-400">*</span>
        </Label>
        <Input
          type="text"
          id="title"
          name="title"
          placeholder="Ej: Navidad en familia 2024"
        />
      </div>

      <!-- Descripción -->
      <div>
        <Label htmlFor="description" className="mb-1.5">Descripción</Label>
        <Textarea
          id="description"
          name="description"
          rows={3}
          placeholder="Cuéntanos algo sobre este momento…"
        />
      </div>

      <!-- Fecha + Etiqueta -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <Label htmlFor="date" className="mb-1.5">
            <Calendar className="w-4 h-4" /> Fecha del recuerdo
          </Label>
          <Input type="date" id="date" name="date" />
        </div>

        <div>
          <Label htmlFor="tag" className="mb-1.5">
            <Tag className="w-4 h-4" /> Categoría
          </Label>
          <select
            id="tag"
            name="tag"
            class="flex h-11 w-full rounded-xl border border-stone-800 bg-stone-950/40 px-4 py-2 text-sm font-medium text-stone-100
                   focus:outline-none focus-visible:border-amber-500/60 focus-visible:ring-3 focus-visible:ring-amber-500/20
                   hover:border-stone-700 transition-all duration-200 cursor-pointer"
          >
            <option value="">Selecciona categoría</option>
            <option value="navidad">🎄 Navidad</option>
            <option value="cumpleanos">🎂 Cumpleaños</option>
            <option value="vacaciones">✈️ Vacaciones</option>
            <option value="familia">👨‍👩‍👧‍👦 Reunión familiar</option>
            <option value="logro">🏆 Logro</option>
            <option value="otro">💛 Otro</option>
          </select>
        </div>
      </div>

      <!-- Compartir con -->
      <div>
        <p class="text-sm font-bold text-stone-300 mb-2 flex items-center gap-1.5">
          <Users className="w-4 h-4 text-amber-400" /> Visible para
        </p>
        <div class="flex flex-wrap gap-2">
          {["Toda la familia", "Adultos", "Mamá", "Papá", "Abuelos", "Solo yo"].map((opt) => (
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" class="w-4 h-4 rounded border-stone-700 bg-stone-900 text-amber-400 focus:ring-amber-500/40 cursor-pointer" />
              <span class="text-sm text-stone-400 font-medium hover:text-stone-200 transition-colors">{opt}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- Botones acción -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <button
          type="submit"
          class:list={[buttonVariants({ variant: "default" }), "flex-1 h-auto py-3.5 text-base"]}
        >
          <Save className="w-4 h-4" />
          Guardar recuerdo
        </button>
        <a
          href="/"
          class:list={[buttonVariants({ variant: "outline" }), "flex-1 h-auto py-3.5 text-base"]}
        >
          <X className="w-4 h-4" />
          Cancelar
        </a>
      </div>
    </form>
  </div>
</Layout>

<script>
  // Preview de imágenes al seleccionar
  const input = document.getElementById("file-input") as HTMLInputElement;
  const preview = document.getElementById("preview") as HTMLDivElement;

  input?.addEventListener("change", () => {
    const files = input.files;
    if (!files || files.length === 0) return;

    preview.innerHTML = "";
    preview.classList.remove("hidden");
    preview.classList.add("grid");

    Array.from(files).forEach((file) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const div = document.createElement("div");
        div.className = "relative rounded-xl overflow-hidden border border-stone-800 aspect-square bg-stone-950/40";

        if (file.type.startsWith("image/")) {
          const img = document.createElement("img");
          img.src = e.target?.result as string;
          img.className = "w-full h-full object-cover";
          div.appendChild(img);
        } else {
          div.innerHTML = `<div class="flex items-center justify-center h-full text-3xl">🎥</div>`;
        }

        const name = document.createElement("p");
        name.textContent = file.name;
        name.className = "absolute bottom-0 left-0 right-0 bg-stone-950/80 text-stone-100 text-xs px-2 py-1 font-medium truncate";
        div.appendChild(name);

        preview.appendChild(div);
      };
      reader.readAsDataURL(file);
    });
  });

  // Highlight dropzone al arrastrar
  const dropzone = document.getElementById("dropzone");
  dropzone?.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropzone.classList.add("border-amber-500", "bg-stone-800/60");
  });
  dropzone?.addEventListener("dragleave", () => {
    dropzone.classList.remove("border-amber-500", "bg-stone-800/60");
  });

  // TODO: aún no existe un endpoint que reciba la subida (falta la lógica de guardado en Supabase).
  const form = document.getElementById("upload-form") as HTMLFormElement;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    console.warn("Subida no implementada todavía.");
  });
</script>
