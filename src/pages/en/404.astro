---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../../layouts/Layout.astro";
import { Compass } from "lucide-react";

const locale = "en";
---

<Layout title="Page not found">
  <div class="flex flex-col items-center justify-center py-24 rounded-3xl border-2 border-dashed border-stone-800 bg-stone-900/20">
    <div class="p-4 rounded-full bg-stone-800 text-stone-500 mb-4">
      <Compass className="w-10 h-10" strokeWidth={1.5} />
    </div>
    <h1 class="text-2xl font-black text-stone-100">404</h1>
    <p class="text-stone-400 font-medium mt-2">This page doesn't exist or was moved</p>
    <a href={getRelativeLocaleUrl(locale, "/")} class="text-amber-500 text-sm mt-4 font-bold hover:underline">Back to home</a>
  </div>
</Layout>
