---
import Layout from "../../layouts/Layout.astro";
import { LifeBuoy, LogIn, Upload, MessageCircleQuestion } from "lucide-react";
---

<Layout title="Support">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8 text-center">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-amber-400 rounded-2xl shadow-inner mb-4">
        <LifeBuoy className="w-8 h-8 text-stone-900" strokeWidth={2.5} />
      </div>
      <h1 class="text-2xl font-extrabold text-stone-100">Support</h1>
      <p class="text-stone-400 text-sm mt-1 font-medium">
        Help with the most common issues, and how to reach out if you need more
      </p>
    </div>

    <div class="space-y-4">
      <div class="bg-stone-900 rounded-2xl border border-stone-800 p-6">
        <div class="flex items-center gap-2 mb-2">
          <LogIn className="w-5 h-5 text-amber-400" />
          <h2 class="font-extrabold text-stone-100">I can't log in</h2>
        </div>
        <p class="text-stone-400 text-sm leading-relaxed">
          Check that your username or email is spelled correctly. If you forgot your password, use
          the "Forgot it?" link on the login screen.
        </p>
      </div>

      <div class="bg-stone-900 rounded-2xl border border-stone-800 p-6">
        <div class="flex items-center gap-2 mb-2">
          <Upload className="w-5 h-5 text-amber-400" />
          <h2 class="font-extrabold text-stone-100">I can't upload a photo or video</h2>
        </div>
        <p class="text-stone-400 text-sm leading-relaxed">
          Make sure you're logged in (the upload button appears next to your avatar) and that the
          file is under 50 MB.
        </p>
      </div>

      <div class="bg-stone-900 rounded-2xl border border-stone-800 p-6">
        <div class="flex items-center gap-2 mb-2">
          <MessageCircleQuestion className="w-5 h-5 text-amber-400" />
          <h2 class="font-extrabold text-stone-100">I have another question</h2>
        </div>
        <p class="text-stone-400 text-sm leading-relaxed">
          Reach out to whoever manages your family account ("admin" role on their profile) for
          anything else.
        </p>
      </div>
    </div>
  </div>
</Layout>
