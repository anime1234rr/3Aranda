---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Entrar" currentPath="/login" showNav={false}>
  <div class="min-h-[70vh] flex items-center justify-center">
    <div class="w-full max-w-md">

      <!-- Card principal -->
      <div class="bg-white rounded-3xl border-2 border-amber-200 shadow-xl p-8">

        <!-- Logo centrado -->
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-amber-100 rounded-2xl text-4xl shadow-inner mb-4">
            🏡
          </div>
          <h1 class="text-2xl font-extrabold text-amber-900">Accede a FamilyHub</h1>
          <p class="text-stone-500 text-sm mt-1 font-medium">Solo para la familia 💛</p>
        </div>

        <!-- Formulario -->
        <div class="space-y-5">
          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-bold text-stone-700 mb-1.5">
              Correo electrónico
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-3.5 flex items-center text-amber-400 text-lg pointer-events-none">
                📧
              </span>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="tu@correo.com"
                class="w-full pl-10 pr-4 py-3 border-2 border-amber-200 rounded-xl text-stone-700 placeholder-stone-300 text-sm font-medium
                       focus:outline-none focus:border-amber-400 focus:bg-amber-50 hover:border-amber-300 transition-all duration-200"
                autocomplete="email"
              />
            </div>
          </div>

          <!-- Contraseña -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-sm font-bold text-stone-700">
                Contraseña
              </label>
              <a href="/recuperar" class="text-xs text-amber-600 hover:text-amber-800 font-semibold transition-colors">
                ¿La olvidaste?
              </a>
            </div>
            <div class="relative">
              <span class="absolute inset-y-0 left-3.5 flex items-center text-amber-400 text-lg pointer-events-none">
                🔒
              </span>
              <input
                type="password"
                id="password"
                name="password"
                placeholder="••••••••"
                class="w-full pl-10 pr-4 py-3 border-2 border-amber-200 rounded-xl text-stone-700 placeholder-stone-300 text-sm font-medium
                       focus:outline-none focus:border-amber-400 focus:bg-amber-50 hover:border-amber-300 transition-all duration-200"
                autocomplete="current-password"
              />
            </div>
          </div>




      </div>
  </div>
</Layout>