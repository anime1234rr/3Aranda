---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Subir Recuerdo" currentPath="/upload">
  <div class="max-w-2xl mx-auto">

    <!-- Título -->
    <div class="mb-8">
      <h1 class="text-2xl font-extrabold text-stone-800 flex items-center gap-2">
        <span>📤</span> Subir un recuerdo
      </h1>
      <p class="text-stone-500 text-sm mt-1 font-medium">
        Comparte un momento especial con toda la familia
      </p>
    </div>

    <div class="bg-white rounded-3xl border-2 border-amber-200 shadow-md p-8 space-y-7">

      <!-- Zona de drop -->
      <div>
        <label class="block text-sm font-bold text-stone-700 mb-2">Archivos</label>
        <div
          id="dropzone"
          class="relative border-2 border-dashed border-amber-300 rounded-2xl p-10 text-center
                 bg-amber-50 hover:bg-amber-100 hover:border-amber-400 transition-all duration-200 cursor-pointer group"
        >
          <input
            type="file"
            id="file-input"
            name="files"
            multiple
            accept="image/*,video/*"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
          />
          <div class="pointer-events-none">
            <p class="text-5xl mb-3">📁</p>
            <p class="font-extrabold text-amber-800 text-base">
              Arrastra tus fotos o vídeos aquí
            </p>
            <p class="text-stone-500 text-sm mt-1 font-medium">
              o haz clic para seleccionar archivos
            </p>
            <p class="text-xs text-stone-400 mt-3 font-medium">
              JPG, PNG, GIF, MP4 · Máx. 50 MB por archivo
            </p>
          </div>
        </div>

        <!-- Preview área -->
        <div id="preview" class="hidden mt-4 grid grid-cols-3 gap-3"></div>
      </div>

      <!-- Título del recuerdo -->
      <div>
        <label for="title" class="block text-sm font-bold text-stone-700 mb-1.5">
          Título del recuerdo <span class="text-rose-400">*</span>
        </label>
        <input
          type="text"
          id="title"
          name="title"
          placeholder="Ej: Navidad en familia 2024"
          class="w-full px-4 py-3 border-2 border-amber-200 rounded-xl text-stone-700 placeholder-stone-300 text-sm font-medium
                 focus:outline-none focus:border-amber-400 focus:bg-amber-50 hover:border-amber-300 transition-all duration-200"
        />
      </div>

      <!-- Descripción -->
      <div>
        <label for="description" class="block text-sm font-bold text-stone-700 mb-1.5">
          Descripción
        </label>
        <textarea
          id="description"
          name="description"
          rows={3}
          placeholder="Cuéntanos algo sobre este momento…"
          class="w-full px-4 py-3 border-2 border-amber-200 rounded-xl text-stone-700 placeholder-stone-300 text-sm font-medium resize-none
                 focus:outline-none focus:border-amber-400 focus:bg-amber-50 hover:border-amber-300 transition-all duration-200"
        ></textarea>
      </div>

      <!-- Fecha + Etiqueta -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="date" class="block text-sm font-bold text-stone-700 mb-1.5">
            📅 Fecha del recuerdo
          </label>
          <input
            type="date"
            id="date"
            name="date"
            class="w-full px-4 py-3 border-2 border-amber-200 rounded-xl text-stone-700 text-sm font-medium
                   focus:outline-none focus:border-amber-400 focus:bg-amber-50 hover:border-amber-300 transition-all duration-200"
          />
        </div>

        <div>
          <label for="tag" class="block text-sm font-bold text-stone-700 mb-1.5">
            🏷️ Categoría
          </label>
          <select
            id="tag"
            name="tag"
            class="w-full px-4 py-3 border-2 border-amber-200 rounded-xl text-stone-700 text-sm font-medium bg-white
                   focus:outline-none focus:border-amber-400 focus:bg-amber-50 hover:border-amber-300 transition-all duration-200 cursor-pointer"
          >
            <option value="">Selecciona categoría</option>
            <option value="navidad">🎄 Navidad</option>
            <option value="cumpleanos">🎂 Cumpleaños</option>
            <option value="vacaciones">✈️ Vacaciones</option>
            <option value="familia">👨‍👩‍👧‍👦 Reunión familiar</option>
            <option value="logro">🏆 Logro</option>
            <option value="otro">💛 Otro</option>
          </select>
        </div>
      </div>

      <!-- Compartir con -->
      <div>
        <p class="text-sm font-bold text-stone-700 mb-2">👥 Visible para</p>
        <div class="flex flex-wrap gap-2">
          {["Toda la familia", "Adultos", "Mamá", "Papá", "Abuelos", "Solo yo"].map((opt) => (
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" class="w-4 h-4 rounded border-amber-300 text-amber-400 focus:ring-amber-300 cursor-pointer" />
              <span class="text-sm text-stone-600 font-medium hover:text-stone-800 transition-colors">{opt}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- Botones acción -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <button
          type="submit"
          class="flex-1 bg-amber-400 hover:bg-amber-500 active:bg-amber-600 text-amber-900 font-extrabold py-3.5 rounded-xl
                 shadow-md hover:shadow-lg transition-all duration-200 text-base flex items-center justify-center gap-2"
        >
          <span>💾</span>
          Guardar recuerdo
        </button>
        <a
          href="/"
          class="flex-1 bg-white border-2 border-amber-200 hover:border-amber-300 hover:bg-amber-50 text-stone-600 font-bold py-3.5 rounded-xl
                 transition-all duration-200 text-base flex items-center justify-center gap-2"
        >
          <span>✕</span>
          Cancelar
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Preview de imágenes al seleccionar
  const input = document.getElementById("file-input") as HTMLInputElement;
  const preview = document.getElementById("preview") as HTMLDivElement;

  input?.addEventListener("change", () => {
    const files = input.files;
    if (!files || files.length === 0) return;

    preview.innerHTML = "";
    preview.classList.remove("hidden");
    preview.classList.add("grid");

    Array.from(files).forEach((file) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const div = document.createElement("div");
        div.className = "relative rounded-xl overflow-hidden border-2 border-amber-200 aspect-square bg-amber-50";

        if (file.type.startsWith("image/")) {
          const img = document.createElement("img");
          img.src = e.target?.result as string;
          img.className = "w-full h-full object-cover";
          div.appendChild(img);
        } else {
          div.innerHTML = `<div class="flex items-center justify-center h-full text-3xl">🎥</div>`;
        }

        const name = document.createElement("p");
        name.textContent = file.name;
        name.className = "absolute bottom-0 left-0 right-0 bg-amber-900/70 text-white text-xs px-2 py-1 font-medium truncate";
        div.appendChild(name);

        preview.appendChild(div);
      };
      reader.readAsDataURL(file);
    });
  });

  // Highlight dropzone al arrastrar
  const dropzone = document.getElementById("dropzone");
  dropzone?.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropzone.classList.add("border-amber-500", "bg-amber-100");
  });
  dropzone?.addEventListener("dragleave", () => {
    dropzone.classList.remove("border-amber-500", "bg-amber-100");
  });
</script>