{
  "extends": "astro/tsconfigs/strict",
  "include": [
    "src/**/*",
    "src/env.d.ts"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": [
      "astro/client"
    ],
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}